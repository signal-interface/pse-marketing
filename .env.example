# Vercel Postgres (auto-set when you provision via Vercel dashboard → Storage)
POSTGRES_URL=

# Salt for privacy-hashing visitor IPs on the commercial funnel
# (rate limiting). REQUIRED — /api/demo-request returns 503 without it.
# Generate with: openssl rand -hex 16. Never commit the real value.
COMMERCIAL_IP_HASH_SALT=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Notification recipient (defaults to info@payrollsynergyexperts.com)
# NOTIFICATION_EMAIL=info@payrollsynergyexperts.com

# Anthropic API key — required for the CHAP AI widget on /chap-ai
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Product tour gate — leave false until screenshots and capability claims
# receive product approval. The route returns 404 while disabled.
PRODUCT_TOUR_ENABLED=false

# Trust layer gate — /trust routes return 404 and stay out of the sitemap
# and footer while disabled.
TRUST_LAYER_ENABLED=false

# trust@ / security@ mailboxes are not provisioned yet. Leave false so the
# trust pages route contact through the demo request path instead of
# publishing addresses that bounce.
TRUST_CONTACTS_LIVE=false

